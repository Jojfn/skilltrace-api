{
  "name": "skilltrace-api",
  "version": "1.0.0",
  "private": true,
  "description": "SkillTrace API - turns capstone contribution data into verified, SFIA-mapped evidence",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --ci --coverage --reporters=default --reporters=jest-junit",
    "lint": "eslint src tests",
    "build": "node scripts/build.js",
    "audit:ci": "npm audit --audit-level=high"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "express": "^4.22.3",
    "jsonwebtoken": "9.0.2",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "eslint": "8.57.0",
    "eslint-plugin-security": "3.0.1",
    "jest": "29.7.0",
    "jest-junit": "^17.0.0",
    "supertest": "7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov",
      "json-summary"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "junit.xml",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}"
  }
}
